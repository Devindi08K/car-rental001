# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# First admin, used only by the seed script. At least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary (server-side signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile. Required in production for the enquiry form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: email the owner on every new enquiry (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
